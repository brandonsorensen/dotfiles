{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "showCacheMissNotices": true,
  "enabledModels": [
    "openai-codex/gpt-*",
    "openai/gpt-*",
    "anthropic/claude-*",
    "openrouter/deepseek/*",
    "ollama/gpt-oss:20b"
  ],
  "theme": "light/dark",
  "quietStartup": true,
  "externalEditor": "nvim",
  "defaultProjectTrust": "ask",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "hideThinkingBlock": false,
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "terminal": {
    "showImages": true,
    "imageWidthCells": 60
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "packages": [
    "npm:pi-diet-ripgrep",
    "npm:@mjakl/pi-kagi-api",
    "npm:pi-lens",
    "npm:pi-vim",
    "npm:@juicesharp/rpiv-todo",
    "npm:@plannotator/pi-extension",
    "npm:pi-web-access",
    "npm:@tmustier/pi-usage-extension",
    "npm:pi-notify",
    "npm:@noice-tech/pi-terminal-bell"
  ],
  "warnings": {
    "anthropicExtraUsage": true
  },
  "lastChangelogVersion": "0.83.0"
}
